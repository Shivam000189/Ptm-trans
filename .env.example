# ==============================================
# Paytm Clone - Environment Variables Configuration
# ==============================================

# MongoDB Root Credentials
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# Backend Database Connection String (MongoDB)
# In Docker Compose network: mongodb:27017
# Local development outside Docker: localhost:27017
MONGO_URI=mongodb://root:password@mongodb:27017/paytm?authSource=admin

# JWT Secret Key
JWT_SECRET=paytm-super-secret-jwt-key-change-in-production

# Server Port
PORT=5000

# Client Allowed Origin (CORS & Socket.io)
CLIENT_URL=http://localhost:80

# Frontend API URL
VITE_API_URL=http://localhost/api
